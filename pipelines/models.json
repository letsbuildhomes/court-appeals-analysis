{
  "schema_version": "models-2",
  "models": {
    "deepseek-flash": {
      "provider": "chat-completions",
      "pricing": {
        "function": "peak-hours",
        "usd_per_million": {
          "input": 0.15,
          "cached_input": 0.003,
          "output": 0.6
        },
        "peak": {
          "multiplier": 2,
          "timezone": "UTC",
          "weekdays": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri"
          ],
          "hours": [
            [
              "01:00",
              "04:00"
            ],
            [
              "06:00",
              "10:00"
            ]
          ]
        }
      },
      "env": "APPEALS",
      "note": "DeepSeek Flash list prices, doubled at weekday peak hours (01:00-04:00 and 06:00-10:00 UTC)."
    }
  }
}
